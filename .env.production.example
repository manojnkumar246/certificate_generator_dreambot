# ════════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# NEVER commit this file. Set these values in your hosting provider's secret/
# environment settings panel instead.
#
# For Railway: https://railway.app → Variables
# For Render:  https://render.com → Environment
# For Azure:   Azure Portal → Key Vault or App Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Gmail SMTP App Password (NOT your phone password or Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Select: Mail, then your device type
APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public HTTPS URL of the deployed app (no trailing slash)
# Examples:
#   https://certificate-generator-yourusername.railway.app
#   https://certificate-generator-yourusername.onrender.com
#   https://certs.yourdomain.com
APP_PUBLIC_URL=https://

# Administrator password for the hosted management UI
# Use a strong random password: 16+ characters, mix of letters, numbers, symbols
# Keep this secret; do NOT share or commit to any repository
APP_ADMIN_PASSWORD=

# Optional: Render-only. If set, Railway.app auto-populates this.
# Leave blank for Railway deployments.
RENDER_EXTERNAL_URL=
